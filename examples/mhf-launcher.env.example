# MHF launcher credentials / connection settings.
# Install to ~/.config/mhf-launcher/env and chmod 600 (it holds a password).

MHF_USER=your_account_name
MHF_PASS=your_password

# MHF_HOST is the address the client is handed for the Entrance server, and it
# is also used as alt_ip_address:8080 for in-game features such as screenshot
# upload. Keep it 127.0.0.1 when you reach the server through the SSH tunnel:
# the server binds 8080 to loopback, so the tunnel is the only route that works.
# Set a real address here only if the API is directly reachable from this machine.
MHF_HOST=127.0.0.1
MHF_PORT=53310

# Which character to log in as: index into the login response's `characters`
# array, 0 = first.
MHF_CHAR_INDEX=0
